{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "oresandstuff.png",
  "environment": "*",
  "mixins": [
    "oresandstuff.fabric.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.abo47.oresandstuff.fabric.FabricMod"
    ],
    "client": [
      "com.abo47.oresandstuff.fabric.FabricModClient"
    ],
    "jade": [
      "com.abo47.oresandstuff.integration.jade.OresAndStuffJadePlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "ldlib": ">=${ldlib_version}"
  },
  "suggests": {
    "jade": "*"
  }
}
